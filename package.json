{
  "name": "diablo",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "verify": "node scripts/verify/verify.mjs",
    "validate:tde-catalog": "node scripts/validate-tde-catalog/validate.mjs",
    "audit:pd2-bkvince": "node scripts/audit-pd2-bkvince/audit.mjs",
    "generate:pd2-skills-workbench": "node scripts/migrate-bkvince/pd2-skills-review.mjs",
    "validate:pd2-skills-workbench": "node --test scripts/migrate-bkvince/pd2-skills-review-data.test.mjs scripts/migrate-bkvince/pd2-skills-review-runtime.test.mjs scripts/migrate-bkvince/pd2-skills-review-ui.test.mjs scripts/migrate-bkvince/pd2-skills-decisions-preview.test.mjs scripts/migrate-bkvince/pd2-skills-workbench-verification.test.mjs scripts/migrate-bkvince/pd2-skills-review.test.mjs && node scripts/migrate-bkvince/pd2-skills-review.mjs --check",
    "smoke:pd2-skills-workbench": "node scripts/migrate-bkvince/pd2-skills-review-browser-smoke.mjs",
    "preview:pd2-skills-decisions": "node scripts/migrate-bkvince/pd2-skills-decisions-preview.mjs",
    "validate:pd2-catalog": "node scripts/validate-pd2-catalog/validate.mjs --require-source",
    "test:pd2-catalog": "node --test scripts/validate-pd2-catalog/validate.test.mjs",
    "workstreams": "node scripts/workstreams/workstreams.mjs",
    "checkpoint": "node scripts/checkpoint/checkpoint.mjs",
    "dev": "concurrently -n api,web -c blue,green \"node scripts/dev-server.js\" \"npm run dev -w apps/admin\"",
    "build": "turbo run build",
    "verify:data": "npm run test:gem-storage && npm run test:pandemonium-storage && npm run test:cube-guide && npm run test:itemstatcost && npm run test:bkvince-startup-refs && npm run test:bkvince-monstats-lots && npm run test:bkvince-storage-bag && npm run test:bkvince-mercenary-command && npm run test:bkvince-super-tk && npm run test:bkvince-itemtypes && npm run test:bkvince-staffmods && npm run test:bkvince-rift-levelgroups && npm run test:bkvince-melee-splash-stats && npm run test:bkvince-bkvcombat-stats && npm run test:bkvince-pd2-affixes",
    "preview": "turbo run preview",
    "generate:schemas": "node scripts/build-data/gen-schemas.js",
    "generate:gem-storage": "node scripts/build-data/gem-storage.js",
    "test:gem-storage": "node scripts/build-data/gem-storage.js --check",
    "generate:pandemonium-storage": "node scripts/build-data/pandemonium-storage.js",
    "test:pandemonium-storage": "node scripts/build-data/pandemonium-storage.js --check",
    "generate:cube-guide": "node scripts/build-data/cube-guide.js",
    "test:cube-guide": "node scripts/build-data/cube-guide.js --check",
    "test:itemstatcost": "node scripts/build-data/audit-itemstatcost.js",
    "test:bkvince-startup-refs": "node scripts/migrate-bkvince/validate-startup-references.js",
    "reset:personnage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-test-character.ps1",
    "test:bkvince-monstats-lots": "node scripts/migrate-bkvince/apply-monstats-lots.js",
    "generate:bkvince-storage-bag": "node scripts/migrate-bkvince/port-storage-bag.js",
    "test:bkvince-storage-bag": "node scripts/migrate-bkvince/port-storage-bag.js --check",
    "generate:bkvince-enhanced-effects": "node scripts/migrate-bkvince/import-enhanced-effects.js",
    "test:bkvince-enhanced-effects": "node scripts/migrate-bkvince/import-enhanced-effects.js --check",
    "generate:bkvince-mercenary-command": "node scripts/migrate-bkvince/port-mercenary-command.js",
    "test:bkvince-mercenary-command": "node scripts/migrate-bkvince/port-mercenary-command.js --check",
    "generate:bkvince-super-tk": "node scripts/migrate-bkvince/port-super-tk.js",
    "test:bkvince-super-tk": "node scripts/migrate-bkvince/port-super-tk.js --check",
    "generate:bkvince-itemtypes": "node scripts/migrate-bkvince/rebuild-itemtypes.js",
    "test:bkvince-itemtypes": "node scripts/migrate-bkvince/rebuild-itemtypes.js --check",
    "generate:bkvince-pd2-affixes": "node scripts/migrate-bkvince/pd2-affixes-review.mjs",
    "generate:bkvince-pd2-affixes-review": "node scripts/migrate-bkvince/pd2-affixes-review.mjs",
    "preview:bkvince-pd2-affix-decisions": "node scripts/migrate-bkvince/pd2-affixes-decisions-preview.mjs",
    "test:bkvince-pd2-affixes": "node --test scripts/migrate-bkvince/pd2-affixes-merge.test.mjs scripts/migrate-bkvince/pd2-affixes-decisions-preview.test.mjs scripts/migrate-bkvince/pd2-affixes-review.test.mjs && node scripts/migrate-bkvince/pd2-affixes-review.mjs --check",
    "generate:bkvince-rift-levelgroups": "node scripts/migrate-bkvince/rift-terror-zone-group.js",
    "test:bkvince-rift-levelgroups": "node scripts/migrate-bkvince/rift-terror-zone-group.js --check",
    "generate:bkvince-staffmods": "node scripts/migrate-bkvince/generate-staffmod-patch.mjs",
    "test:bkvince-staffmods": "node scripts/migrate-bkvince/generate-staffmod-patch.mjs --check",
    "test:extended-item-stats": "node --test scripts/reverse-engineering/extended-item-stats-fixture.test.mjs scripts/reverse-engineering/extended-item-transport.test.mjs",
    "generate:extended-item-stats-fixture": "node scripts/reverse-engineering/extended-item-stats-fixture.mjs --output analysis-cache/extended-item-stats/synthetic-120-stats.d2i",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/Build-NativePlugins.ps1",
    "re:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/Runtime-Tools.ps1",
    "re:d2r32:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/Capture-D2RRuntime.ps1",
    "re:d2r32": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/d2r32.ps1",
    "re:refs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/references.ps1",
    "ref:d2moo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/references.ps1 -Reference d2moo",
    "ref:d2ssharp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/references.ps1 -Reference d2ssharp",
    "ref:d2rlplugins": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/references.ps1 -Reference d2rlplugins",
    "re:d2r32:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/Initialize-D2R32Workbench.ps1",
    "re:d2r32:ghidra-import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/Import-D2R32Ghidra.ps1",
    "re:d2r32:ghidra": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reverse-engineering/Invoke-D2R32Ghidra.ps1",
    "generate:bkvince-melee-splash-stats": "node scripts/migrate-bkvince/apply-melee-splash-stats.js --apply",
    "test:bkvince-melee-splash-stats": "node scripts/migrate-bkvince/apply-melee-splash-stats.js --check",
    "generate:bkvince-bkvcombat-stats": "node scripts/migrate-bkvince/apply-bkvcombat-stats.js --apply",
    "test:bkvince-bkvcombat-stats": "node scripts/migrate-bkvince/apply-bkvcombat-stats.js --check"
  },
  "devDependencies": {
    "@d2runewizard/d2s": "2.0.132",
    "@playwright/test": "1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.1.2",
    "patch-package": "^8.0.1",
    "turbo": "^2.10.5"
  }
}
