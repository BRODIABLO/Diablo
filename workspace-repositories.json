{
  "schemaVersion": 2,
  "repositories": [
    {
      "id": "workspace",
      "role": "incubation-and-runtime-laboratory",
      "path": ".",
      "environmentVariable": "DIABLO_WORKSPACE_ROOT",
      "required": true
    },
    {
      "id": "suite",
      "role": "public-product-source",
      "path": "../RuffnecKk-D2RLoader-Suite",
      "environmentVariable": "RUFFNECKK_SUITE_ROOT",
      "workstreamId": "ruffneckk-suite-next-release",
      "required": true
    }
  ],
  "locations": [
    {
      "id": "suite-governance",
      "role": "public-release-governance",
      "path": "governance/d2rloader-suite",
      "required": true
    }
  ]
}
