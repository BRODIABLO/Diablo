{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruffneckk.local/schemas/pd2-skills-decisions-v3.schema.json",
  "title": "PD2 Skills Merge Workbench decision envelope",
  "description": "Governed, preview-only design decisions. ALL may retain structurally valid work in progress; the runtime enforces semantic completion for COMPLETE_ONLY and preview. This document grants no gameplay implementation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "reviewId",
    "comparisonHash",
    "frozenContractHash",
    "sourceHashes",
    "exportedAt",
    "exportScope",
    "schemaPolicy",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "pd2-skills-review-decisions" },
    "reviewId": { "const": "pd2-skills-review-v1" },
    "comparisonHash": { "$ref": "#/$defs/sha256" },
    "frozenContractHash": {
      "const": "E27F45EB00D0AB1BD9A39053FD4E9CD4A3D0001792CCAA2E7ED38374E8D9676F"
    },
    "sourceHashes": { "$ref": "#/$defs/hashObject" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "exportScope": { "enum": ["ALL", "COMPLETE_ONLY"] },
    "schemaPolicy": {
      "description": "Autonomous governed Phase 0 schema-policy envelope; null only for reports that predate schema orientation.",
      "oneOf": [
        { "$ref": "#/$defs/schemaPolicyEnvelope" },
        { "type": "null" }
      ]
    },
    "entries": {
      "type": "object",
      "propertyNames": { "pattern": "^skill:[a-z0-9-]+:[a-z0-9-]+(?::[a-z0-9-]+)?$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "exportScope": { "const": "COMPLETE_ONLY" } },
        "required": ["exportScope"]
      },
      "then": {
        "properties": {
          "entries": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/completeEntry" }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "hashObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/hashTree" }
    },
    "hashTree": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hashTree" }
        },
        { "$ref": "#/$defs/hashObject" }
      ]
    },
    "policyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "decision", "justification"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["PENDING", "APPROVE", "MODIFY", "REJECT", "DISCUSS"] },
        "justification": { "type": "string" },
        "customPolicy": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "APPROVE" } }, "required": ["decision"] },
          "then": { "properties": { "justification": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "decision": { "const": "MODIFY" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "justification": { "type": "string", "minLength": 1 },
              "customPolicy": { "type": "string", "minLength": 1 }
            },
            "required": ["customPolicy"]
          }
        },
        {
          "if": { "properties": { "decision": { "not": { "const": "MODIFY" } } }, "required": ["decision"] },
          "then": { "not": { "required": ["customPolicy"] } }
        }
      ]
    },
    "schemaPolicyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "orientationId",
        "orientationHash",
        "frozenContractHash",
        "sourceHashes",
        "exportedAt",
        "decisions"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "pd2-skills-schema-policy" },
        "orientationId": { "const": "pd2-skills-schema-orientation-v1" },
        "orientationHash": { "$ref": "#/$defs/sha256" },
        "frozenContractHash": { "const": "3133A16AD42315181599DBB5DE29C4C7DAEBC5DFB7F1110639C2CEBFEA13EC6B" },
        "sourceHashes": { "$ref": "#/$defs/hashObject" },
        "exportedAt": { "type": "string", "format": "date-time" },
        "decisions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/policyDecision" }
        }
      }
    },
    "globalDecision": {
      "enum": [
        "KEEP_BKVINCE",
        "ADAPT_PD2_SELECTIVELY",
        "ADOPT_PD2_MODEL",
        "IMPORT_NEW_PD2_SKILL",
        "REJECT_PD2",
        "DEFER_NATIVE_PROOF",
        "DISCUSS"
      ]
    },
    "componentDecision": {
      "enum": ["KEEP_BKVINCE", "ADOPT_PD2", "CUSTOM", "DISCUSS", "NOT_APPLICABLE"]
    },
    "newSkillLineDecision": {
      "enum": [
        "IMPORT_APPEND_ONLY",
        "IMPORT_CUSTOMIZED",
        "REJECT_PD2_SKILL",
        "DEFER_NATIVE_PROOF",
        "DISCUSS"
      ]
    },
    "implementationStatus": {
      "enum": [
        "NOT_REVIEWED",
        "DECISION_INCOMPLETE",
        "DECISION_COMPLETE",
        "SELECTED_FOR_PROTOTYPE",
        "IMPLEMENTATION_NOT_AUTHORIZED",
        "IMPLEMENTATION_AUTHORIZED",
        "IMPLEMENTED",
        "TESTED",
        "REJECTED"
      ]
    },
    "proofStatus": {
      "enum": [
        "EXACT_TABLE",
        "EXACT_FORMULA",
        "EXACT_DERIVED",
        "SYMBOLIC",
        "MALFORMED_SOURCE",
        "UNSUPPORTED_IDENTIFIER",
        "NATIVE_UNPROVEN"
      ]
    },
    "protectedOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": { "type": "boolean" },
        "justification": { "type": "string" },
        "acknowledgedProofStatus": { "$ref": "#/$defs/proofStatus" },
        "nativeRiskAccepted": { "type": "boolean" },
        "malformedResolution": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "description": "Base choice shape. Bundle CUSTOM uses customValues; expert field CUSTOM uses customValue.",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "$ref": "#/$defs/componentDecision" },
        "customValue": { "type": "string" },
        "customValues": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "justification": { "type": "string" },
        "gameplayObjective": { "type": "string" },
        "testPlan": { "type": "string" },
        "protectedOverride": { "$ref": "#/$defs/protectedOverride" },
        "expertOverride": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "justification"],
          "properties": {
            "enabled": { "const": true },
            "justification": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "bundleChoice": {
      "allOf": [
        { "$ref": "#/$defs/choice" },
        {
          "not": {
            "anyOf": [
              { "type": "object", "properties": { "customValue": {} }, "required": ["customValue"] },
              { "type": "object", "properties": { "expertOverride": {} }, "required": ["expertOverride"] }
            ]
          }
        }
      ]
    },
    "expertFieldChoice": {
      "allOf": [
        { "$ref": "#/$defs/choice" },
        { "type": "object", "properties": { "expertOverride": { "type": "object" } }, "required": ["expertOverride"] },
        { "not": { "type": "object", "properties": { "customValues": {} }, "required": ["customValues"] } }
      ]
    },
    "completeBundleChoice": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/bundleChoice" },
        {
          "properties": {
            "decision": { "enum": ["KEEP_BKVINCE", "ADOPT_PD2", "CUSTOM", "NOT_APPLICABLE"] }
          },
          "required": ["decision"]
        },
        {
          "if": {
            "properties": { "decision": { "const": "CUSTOM" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "customValues": { "type": "object", "minProperties": 1 },
              "justification": { "type": "string", "minLength": 1 },
              "testPlan": { "type": "string", "minLength": 1 }
            },
            "required": ["customValues", "justification", "testPlan"]
          }
        }
      ]
    },
    "completeExpertFieldChoice": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/expertFieldChoice" },
        {
          "properties": {
            "decision": { "enum": ["KEEP_BKVINCE", "ADOPT_PD2", "CUSTOM", "NOT_APPLICABLE"] },
            "expertOverride": { "$ref": "#/$defs/choice/properties/expertOverride" }
          },
          "required": ["decision", "expertOverride"]
        },
        {
          "if": { "properties": { "decision": { "const": "CUSTOM" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "customValue": { "type": "string", "minLength": 1 },
              "justification": { "type": "string", "minLength": 1 },
              "testPlan": { "type": "string", "minLength": 1 }
            },
            "required": ["customValue", "justification", "testPlan"]
          }
        }
      ]
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["general", "designObjective", "bkvinceProblem", "finalJustification", "testPlan"],
      "properties": {
        "general": { "type": "string" },
        "designObjective": { "type": "string" },
        "bkvinceProblem": { "type": "string" },
        "finalJustification": { "type": "string" },
        "testPlan": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "globalDecision",
        "implementationStatus",
        "bundleDecisions",
        "fieldDecisions",
        "notes"
      ],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "globalDecision": {
          "oneOf": [
            { "$ref": "#/$defs/globalDecision" },
            { "type": "null" }
          ]
        },
        "newSkillLineDecision": {
          "oneOf": [
            { "$ref": "#/$defs/newSkillLineDecision" },
            { "type": "null" }
          ]
        },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "bundleDecisions": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/bundleChoice" }
        },
        "fieldDecisions": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/expertFieldChoice" }
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "completeEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/entry" },
        {
          "properties": {
            "globalDecision": {
              "enum": ["KEEP_BKVINCE", "ADAPT_PD2_SELECTIVELY", "ADOPT_PD2_MODEL", "IMPORT_NEW_PD2_SKILL", "REJECT_PD2", "DEFER_NATIVE_PROOF"]
            },
            "newSkillLineDecision": {
              "enum": ["IMPORT_APPEND_ONLY", "IMPORT_CUSTOMIZED", "REJECT_PD2_SKILL", "DEFER_NATIVE_PROOF"]
            },
            "bundleDecisions": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/completeBundleChoice" }
            },
            "fieldDecisions": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/completeExpertFieldChoice" }
            }
          },
          "required": ["globalDecision"]
        },
        {
          "if": {
            "properties": {
              "globalDecision": {
                "enum": ["KEEP_BKVINCE", "ADAPT_PD2_SELECTIVELY", "ADOPT_PD2_MODEL", "IMPORT_NEW_PD2_SKILL", "REJECT_PD2"]
              }
            },
            "required": ["globalDecision"]
          },
          "then": {
            "properties": {
              "notes": {
                "type": "object",
                "properties": { "finalJustification": { "type": "string", "minLength": 1 } },
                "required": ["finalJustification"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "globalDecision": { "enum": ["ADAPT_PD2_SELECTIVELY", "ADOPT_PD2_MODEL", "IMPORT_NEW_PD2_SKILL"] }
            },
            "required": ["globalDecision"]
          },
          "then": {
            "properties": {
              "notes": {
                "type": "object",
                "properties": { "testPlan": { "type": "string", "minLength": 1 } },
                "required": ["testPlan"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "globalDecision": { "const": "DEFER_NATIVE_PROOF" } },
            "required": ["globalDecision"]
          },
          "then": {
            "properties": {
              "notes": {
                "type": "object",
                "anyOf": [
                  {
                    "properties": { "general": { "type": "string", "minLength": 1 } },
                    "required": ["general"]
                  },
                  {
                    "properties": { "finalJustification": { "type": "string", "minLength": 1 } },
                    "required": ["finalJustification"]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "implementationStatus": {
                "enum": ["SELECTED_FOR_PROTOTYPE", "IMPLEMENTATION_NOT_AUTHORIZED", "IMPLEMENTATION_AUTHORIZED", "IMPLEMENTED", "TESTED"]
              }
            },
            "required": ["implementationStatus"]
          },
          "then": {
            "properties": {
              "notes": {
                "type": "object",
                "properties": { "testPlan": { "type": "string", "minLength": 1 } },
                "required": ["testPlan"]
              }
            }
          }
        }
      ]
    }
  }
}
