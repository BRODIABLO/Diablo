{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruffneckk.local/schemas/tde-inspiration-bkvince.schema.json",
  "title": "TDE inspiration catalog for BKVince",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "status", "source", "method", "coverage", "credits", "entries", "shortlists"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "tde-inspiration-bkvince" },
    "status": { "enum": ["study", "approved", "retired"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "archiveFile", "archiveSha256", "readmePath", "paragraphCount", "tableCount", "reviewedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "archiveFile": { "type": "string", "minLength": 1 },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "readmePath": { "type": "string", "minLength": 1 },
        "paragraphCount": { "type": "integer", "minimum": 1 },
        "tableCount": { "type": "integer", "minimum": 0 },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scoringFormula", "copyrightBoundary", "implementationBoundary"],
      "properties": {
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "scoringFormula": { "const": "playerValue*6 + bkvinceFit*5 + technicalConfidence*4 + isolation*3 + maintenance*2" },
        "copyrightBoundary": { "type": "string", "minLength": 1 },
        "implementationBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readmeChunks", "tables", "compatibilityAudit"],
      "properties": {
        "readmeChunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end", "sha256"],
            "properties": {
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "tables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "manifestSha256", "allCrlf", "roundTripByteExact"],
          "properties": {
            "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+\\.txt$" } },
            "manifestSha256": { "$ref": "#/$defs/sha256" },
            "allCrlf": { "type": "boolean" },
            "roundTripByteExact": { "type": "boolean" }
          }
        },
        "compatibilityAudit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commonTables", "exactHeaders", "schemaDifferences", "tdeOnly", "bkvinceOnly"],
          "properties": {
            "commonTables": { "type": "integer", "minimum": 0 },
            "exactHeaders": { "type": "integer", "minimum": 0 },
            "schemaDifferences": { "type": "integer", "minimum": 0 },
            "tdeOnly": { "type": "integer", "minimum": 0 },
            "bkvinceOnly": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "credits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "shortlists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataFirst", "native"],
      "properties": {
        "dataFirst": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "native": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lane", "domain", "playerEffect", "sourceRefs", "tableEvidence", "route", "disposition", "scores", "effort", "requiresNewAssets", "nativeProofStatus", "futureDestinationGateRequired", "rationale", "dependencies"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "lane": { "enum": ["data", "native", "excluded"] },
        "domain": { "enum": ["ui", "character", "skill", "hireling", "monster", "item", "cube", "world", "npc", "system", "compatibility"] },
        "playerEffect": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^readme:p[1-9][0-9]*$" } },
        "tableEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+\\.txt$" } },
        "existingCoverage": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "route": { "enum": ["data_only", "plugin", "memory_patch", "data_native", "none"] },
        "disposition": { "enum": ["shortlisted", "candidate", "duplicate", "rejected", "excluded_asset", "needs_evidence"] },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerValue", "bkvinceFit", "technicalConfidence", "isolation", "maintenance", "priority"],
          "properties": {
            "playerValue": { "$ref": "#/$defs/score" },
            "bkvinceFit": { "$ref": "#/$defs/score" },
            "technicalConfidence": { "$ref": "#/$defs/score" },
            "isolation": { "$ref": "#/$defs/score" },
            "maintenance": { "$ref": "#/$defs/score" },
            "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "effort": { "enum": ["low", "medium", "high", "unknown"] },
        "requiresNewAssets": { "type": "boolean" },
        "nativeProofStatus": { "enum": ["not_applicable", "existing", "partial", "missing"] },
        "futureDestinationGateRequired": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
