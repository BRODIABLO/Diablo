{
  "name": "bkvince-hero-editor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "extract:vanilla-ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extract-vanilla-ui-assets.ps1",
    "generate": "node scripts/generate-constants.mjs && node scripts/generate-ui-assets.mjs",
    "check:constants": "node scripts/generate-constants.mjs --check",
    "test": "node --test src/lib/*.test.js",
    "dev": "npm run generate && vite",
    "build": "npm run generate && npm test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@d2runewizard/d2s": "2.0.132",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.4"
  }
}
